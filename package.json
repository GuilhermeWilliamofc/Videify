{
  "name": "videify",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npx electron-packager . Videify --platform=win32 --arch=x64 --out=release-builds --overwrite --icon=public/images/icon.ico --ignore=\"^/release-builds|\\.git(ignore)?$\"",
    "postbuild": "node scripts/postbuild.js"
  },
  "dependencies": {
    "connect-flash": "^0.1.1",
    "discord-rpc": "^4.0.1",
    "electron": "^30.0.0",
    "express": "^4.18.2",
    "express-handlebars": "^7.0.7",
    "express-session": "^1.17.3",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2"
  }
}
