<div class="card mt-4">
        <div class="card-body">
            <h1 class="mb-3">Meus Downloads &#x1F4E5;</h1>
            <p class="lead mb-4">Seus arquivos baixados localmente.</p>
            <a href="/form_download" class="link"><button class="botao" style="margin-bottom: 20px;">+ Novo Download</button></a>
            
            <div class="row">
                {{#if downloads.length}}
                    {{#each downloads}}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-sm border-0" style="background-color: #f8f9fa;">
                            {{#if this.thumbnail}}
                                <img src="{{this.thumbnail}}" class="card-img-top" alt="Thumbnail" style="height: 180px; object-fit: contain; background-color: #222;">
                            {{else}}
                                <div class="card-img-top d-flex align-items-center justify-content-center" style="height: 180px; background-color: #333; color: white;">
                                    Sem Capa
                                </div>
                            {{/if}}
                            
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-truncate" title="{{this.title}}" style="font-weight: bold; margin-bottom: 5px;">{{this.title}}</h6>
                                <p class="card-text small text-muted mb-3" style="font-size: 0.85rem;">
                                    {{#if (eq this.type "img")}}<span class="badge bg-info text-dark">Imagem</span>{{/if}}
                                    {{#if (eq this.type "yt_video")}}<span class="badge bg-danger">Vídeo Youtube</span>{{/if}}
                                    {{#if (eq this.type "yt_mp3")}}<span class="badge bg-primary">Áudio MP3</span>{{/if}}
                                    {{#if (eq this.type "yt_opus")}}<span class="badge bg-secondary">Áudio OPUS</span>{{/if}}
                                    <span style="display:block; margin-top:5px;">Baixado em: {{this.date}}</span>
                                </p>
                                
                                <div class="mt-auto">
                                    {{#if (eq this.type "img")}}
                                        <a href="{{this.path}}" target="_blank" class="btn btn-sm text-white w-100" style="background-color: #2b78e4; margin-bottom: 10px;">Visualizar Imagem</a>
                                    {{/if}}

                                    {{#if (eq this.type "yt_video")}}
                                        <a href="{{this.path}}" target="_blank" class="btn btn-sm text-white w-100" style="background-color: #2b78e4; margin-bottom: 10px;">Vídeo Completo</a>
                                    {{/if}}

                                    {{#if (eq this.type "yt_mp3")}}
                                        <a href="{{this.path}}" target="_blank" class="btn btn-sm text-white w-100" style="background-color: #2b78e4; margin-bottom: 10px;">Arquivo .MP3</a>
                                        <audio controls src="{{this.path}}" style="width: 100%; height: 40px;"></audio>
                                    {{/if}}

                                    {{#if (eq this.type "yt_opus")}}
                                        <a href="{{this.path}}" target="_blank" class="btn btn-sm text-white w-100" style="background-color: #2b78e4; margin-bottom: 10px;">Arquivo .OPUS</a>
                                        <audio controls src="{{this.path}}" style="width: 100%; height: 40px;"></audio>
                                    {{/if}}
                                </div>
                            </div>
                        </div>
                    </div>
                    {{/each}}
                {{else}}
                    <div class="col-12">
                        <div class="alert alert-info" style="border-radius: 6px;">Você ainda não tem nenhum arquivo baixado pelo Videify.</div>
                    </div>
                {{/if}}
            </div>
        </div>
</div>