<div class="card mt-4">
        <div class="card-body">
            <h1>Baixar Vídeo/Imagem</h1>
            <hr>
            <form action="/baixar" method="post" autocomplete="off">
                <div class="input">
                    <label for="itipolink">Tipo de Link: </label>
                    <select name="tipo" id="itipolink" required>
                        <option value="" selected>--- Escolha ---</option>
                        <optgroup label="Tipos de Link">
                            <option value="yt">Vídeo Youtube</option>
                            <option value="img">Imagem</option>
                        </optgroup>
                    </select>
                </div>
                <div class="input">
                    <label for="ilink">Link: </label>
                    <input type="text" name="link" id="ilink" required placeholder="Cole seu link aqui...">
                </div>
                <div class="input">
                    <input py-click="baixar" class="submit" type="submit" value="Enviar">
                    <input type="reset" value="Limpar">
                </div>
                <p id="textoteste"></p>
            </form>
        </div>
</div>

<py-script>
from js import document, fetch, JSON, Object

async def baixar(event=None):
    tipo = document.getElementById("itipolink").value
    link = document.getElementById("ilink").value

    if not tipo or not link:
        print("Preencha os campos corretamente.")
        return

    body = { "tipo": tipo, "link": link }

    headers = Object.fromEntries([["Content-Type", "application/json"]])

    response = await fetch(
        "/baixar",
        {
            "method": "POST",
            "headers": headers,
            "body": JSON.stringify(body)
        }
    )

    if response.ok:
        print("Download iniciado!")
    else:
        print("Erro ao iniciar download.")

</py-script>