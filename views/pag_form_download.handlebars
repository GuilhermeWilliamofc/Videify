<div class="card mt-4">
        <div class="card-body">
            <h1 data-i18n="dl-title">Baixar Vídeo/Imagem</h1>
            <hr>
            <form id="downloadForm" autocomplete="off">
                <div class="input">
                    <label for="itipolink" data-i18n="dl-label-type">Tipo de Link: </label>
                    <select name="tipo" id="itipolink" required onchange="toggleFormato()">
                        <option value="" selected data-i18n="dl-opt-choose">--- Escolha ---</option>
                        <optgroup label="Tipos de Link">
                            <option value="yt" data-i18n="dl-opt-yt">Vídeo Youtube</option>
                            <option value="playlist" data-i18n="dl-opt-playlist">Playlist do Youtube</option>
                            <option value="img" data-i18n="dl-opt-img">Imagem</option>
                        </optgroup>
                    </select>
                </div>
                <div class="input" id="formatoContainer" style="display: none;">
                    <label for="iformato" data-i18n="dl-label-fmt">Formato (Youtube): </label>
                    <select name="formato" id="iformato">
                        <option value="video" selected data-i18n="dl-opt-video">Vídeo Completo (MP4)</option>
                        <option value="mp3" data-i18n="dl-opt-mp3">Somente Áudio (MP3)</option>
                        <option value="opus" data-i18n="dl-opt-opus">Somente Áudio (OPUS)</option>
                    </select>
                </div>
                <div class="input">
                    <label for="ilink" data-i18n="dl-label-link">Link: </label>
                    <input type="text" name="link" id="ilink" required data-i18n-ph="dl-ph-link" placeholder="Cole seu link aqui...">
                </div>
                <div class="input">
                    <button class="submit" type="submit" id="btnDownload" data-i18n="dl-btn-download" style="cursor: pointer; padding: 10px 15px; border: none; background-color: #2b78e4; color: white; border-radius: 4px; font-weight: bold;">Baixar</button>
                    <button type="reset" id="btnReset" data-i18n="dl-btn-clear" style="cursor: pointer; padding: 10px 15px; border: none; background-color: #f1f1f1; color: black; border-radius: 4px; border: 1px solid #ccc;">Limpar</button>
                    <a href="/downloads" style="margin-left: auto; text-decoration: none;"><button type="button" id="btnCancel" data-i18n="dl-btn-cancel" style="background-color: transparent; color: #ff8e99; border: 2px solid #dc3545; padding: 10px 15px; border-radius: 10px; cursor: pointer; transition: 0.3s;" onmouseover="this.style.backgroundColor='#dc3545'; this.style.color='white';" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#ff8e99';">Cancelar</button></a>
                </div>
            </form>

            <div id="progressContainer" style="display: none; margin-top: 20px;">
                <p id="statusMsg" style="font-weight: bold; margin-bottom: 5px;">Iniciando download...</p>
                <div style="background-color: #e0e0e0; border-radius: 5px; width: 100%; height: 25px; overflow: hidden;">
                    <div id="progressBar" style="background-color: #4caf50; width: 0%; height: 100%; transition: width 0.3s ease; display: flex; align-items: center; justify-content: flex-end; padding-right: 5px; color: white; font-size: 13px; font-weight: bold;"></div>
                </div>
            </div>
            <div id="resultContainer" style="margin-top: 15px;"></div>

            <!-- Modal de Seleção de Playlist -->
            <div id="playlistModal" style="display: none; position: fixed; z-index: 9999; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.6);">
                <div style="background-color: #fefefe; margin: 2% auto; padding: 20px; border: 1px solid #888; border-radius: 8px; width: 90%; max-width: 1000px; max-height: 85vh; overflow-y: auto;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                        <h2 id="playlistTitle" style="margin: 0; color: #1a0033;">Selecione os vídeos</h2>
                        <button onclick="closePlaylistModal()" style="background: none; border: none; font-size: 28px; cursor: pointer; color: #aaa;">&times;</button>
                    </div>
                    
                    <div class="select-all-container" style="margin-bottom: 15px; padding: 10px; background-color: #f0f0f0; border-radius: 5px;">
                        <label style="display: flex; align-items: center; cursor: pointer;">
                            <input type="checkbox" id="selectAllVideos" onchange="toggleSelectAll()" style="margin-right: 10px; width: 18px; height: 18px;">
                            <strong style="color: #1a0033;">Selecionar todos os vídeos (<span id="totalVideosCount">0</span>)</strong>
                        </label>
                    </div>
                    
                    <div id="playlistVideos" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 15px;">
                        <!-- Vídeos serão inseridos aqui via JavaScript -->
                    </div>
                    
                    <div style="margin-top: 20px; text-align: right; border-top: 1px solid #ddd; padding-top: 15px;">
                        <button onclick="closePlaylistModal()" style="padding: 10px 20px; margin-right: 10px; background-color: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">Cancelar</button>
                        <button onclick="downloadSelectedVideos()" style="padding: 10px 20px; background-color: #2b78e4; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">Baixar Selecionados</button>
                    </div>
                </div>
            </div>

            <script>
            let playlistVideosData = [];
            let currentPlaylistFormat = 'video';

            function toggleFormato() {
                const tipo = document.getElementById('itipolink').value;
                const container = document.getElementById('formatoContainer');
                if (tipo === 'yt' || tipo === 'playlist') {
                    container.style.display = 'block';
                } else {
                    container.style.display = 'none';
                    if (document.getElementById('iformato')) {
                        document.getElementById('iformato').value = 'video';
                    }
                }
            }

            function closePlaylistModal() {
                document.getElementById('playlistModal').style.display = 'none';
                playlistVideosData = [];
            }

            function toggleSelectAll() {
                const selectAll = document.getElementById('selectAllVideos').checked;
                document.querySelectorAll('.video-checkbox').forEach(cb => {
                    cb.checked = selectAll;
                });
            }

            function formatDuration(seconds) {
                const hours = Math.floor(seconds / 3600);
                const minutes = Math.floor((seconds % 3600) / 60);
                const secs = seconds % 60;
                if (hours > 0) {
                    return `${hours}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }
                return `${minutes}:${secs.toString().padStart(2, '0')}`;
            }

            async function loadPlaylistInfo(url, formato) {
                const progressContainer = document.getElementById('progressContainer');
                const statusMsg = document.getElementById('statusMsg');
                const resultContainer = document.getElementById('resultContainer');
                
                progressContainer.style.display = 'block';
                statusMsg.innerText = 'Buscando informações da playlist...';
                resultContainer.innerHTML = '';

                try {
                    const response = await fetch('/api/playlist-info', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ url })
                    });

                    const reader = response.body.getReader();
                    const decoder = new TextDecoder("utf-8");
                    let done = false;
                    let buffer = "";
                    let finalData = null;

                    while (!done) {
                        const { value, done: readerDone } = await reader.read();
                        done = readerDone;
                        
                        if (value) {
                            buffer += decoder.decode(value, { stream: true });
                            const lines = buffer.split('\n');
                            
                            // Processa todas as linhas completas, mantém a última incompleta
                            for (let i = 0; i < lines.length - 1; i++) {
                                const line = lines[i].trim();
                                if (line.startsWith('data: ')) {
                                    const jsonStr = line.substring(6).trim();
                                    if (jsonStr) {
                                        try {
                                            const data = JSON.parse(jsonStr);
                                            
                                            if (data.status) {
                                                statusMsg.innerText = data.status;
                                            }
                                            if (data.progress) {
                                                // Exibe progresso se necessário
                                            }
                                            if (data.success === true) {
                                                // Guarda os dados finais
                                                finalData = data;
                                            } else if (data.success === false) {
                                                // Erro ao carregar playlist
                                                resultContainer.innerHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"><strong>Erro:</strong> ${data.error}</div>`;
                                                progressContainer.style.display = 'none';
                                                return;
                                            }
                                        } catch (e) {
                                            console.error("Erro ao parsear JSON:", e, "String:", jsonStr);
                                        }
                                    }
                                }
                            }
                            
                            buffer = lines[lines.length - 1];
                        }
                    }
                    
                    // Processa qualquer linha final restante
                    if (buffer.trim()) {
                        const line = buffer.trim();
                        if (line.startsWith('data: ')) {
                            const jsonStr = line.substring(6).trim();
                            if (jsonStr) {
                                try {
                                    const data = JSON.parse(jsonStr);
                                    if (data.success === true) {
                                        finalData = data;
                                    }
                                } catch (e) {
                                    console.error("Erro ao parsear JSON final:", e);
                                }
                            }
                        }
                    }
                    
                    // Exibe o modal se temos dados
                    if (finalData && finalData.videos && finalData.videos.length > 0) {
                        playlistVideosData = finalData.videos;
                        currentPlaylistFormat = formato;
                        showPlaylistModal(finalData);
                        progressContainer.style.display = 'none';
                    } else {
                        resultContainer.innerHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"><strong>Erro:</strong> Nenhum vídeo encontrado na playlist.</div>`;
                        progressContainer.style.display = 'none';
                    }
                } catch (err) {
                    resultContainer.innerHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"><strong>Erro:</strong> ${err.message}</div>`;
                    progressContainer.style.display = 'none';
                }
            }

            function showPlaylistModal(data) {
                const modal = document.getElementById('playlistModal');
                const playlistTitle = document.getElementById('playlistTitle');
                const playlistVideos = document.getElementById('playlistVideos');
                const totalVideosCount = document.getElementById('totalVideosCount');
                
                playlistTitle.innerText = data.playlist_title || 'Selecione os vídeos';
                totalVideosCount.innerText = data.videos.length;
                
                playlistVideos.innerHTML = '';
                
                data.videos.forEach((video, index) => {
                    const videoCard = document.createElement('div');
                    videoCard.className = 'video-card';
                    videoCard.style.cssText = 'border: 2px solid #ddd; border-radius: 8px; padding: 10px; background-color: white; cursor: pointer; transition: all 0.2s;';
                    videoCard.onmouseover = () => videoCard.style.borderColor = '#2b78e4';
                    videoCard.onmouseout = () => {
                        if (!videoCard.querySelector('.video-checkbox').checked) {
                            videoCard.style.borderColor = '#ddd';
                        }
                    };
                    
                    videoCard.innerHTML = `
                        <label style="display: flex; flex-direction: column; cursor: pointer; height: 100%;">
                            <div style="position: relative; width: 100%; padding-bottom: 56.25%; background-color: #000; border-radius: 4px; overflow: hidden; margin-bottom: 10px;">
                                <img src="${video.thumbnail}" alt="${video.title}" 
                                     style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;"
                                     onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 320 180%22%3E%3Crect fill=%22%23ccc%22 width=%22320%22 height=%22180%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22 fill=%22%23666%22 font-family=%22Arial%22 font-size=%2214%22%3ESem thumbnail%3C/text%3E%3C/svg%3E'">
                                <div style="position: absolute; bottom: 5px; right: 5px; background-color: rgba(0,0,0,0.8); color: white; padding: 2px 5px; border-radius: 3px; font-size: 11px; font-weight: bold;">
                                    ${formatDuration(video.duration)}
                                </div>
                            </div>
                            <div style="flex: 1; display: flex; flex-direction: column;">
                                <div style="display: flex; align-items: start; gap: 8px; margin-bottom: 5px;">
                                    <input type="checkbox" class="video-checkbox" data-index="${index}" 
                                           style="margin-top: 2px; width: 18px; height: 18px; flex-shrink: 0;"
                                           onchange="event.stopPropagation(); updateVideoCardStyle(this)">
                                    <div style="flex: 1; overflow: hidden;">
                                        <div class="video-title" style="font-size: 13px; font-weight: bold; line-height: 1.3; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-bottom: 4px; color: #1a0033;">
                                            ${video.title}
                                        </div>
                                        <div class="video-channel" style="font-size: 11px; color: #666;">
                                            ${video.channel}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </label>
                    `;
                    
                    playlistVideos.appendChild(videoCard);
                });
                
                document.getElementById('selectAllVideos').checked = false;
                modal.style.display = 'block';
            }

            function updateVideoCardStyle(checkbox) {
                const card = checkbox.closest('div[style*="border"]');
                if (card) {
                    card.style.borderColor = checkbox.checked ? '#2b78e4' : '#ddd';
                    card.style.backgroundColor = checkbox.checked ? '#f0f7ff' : 'white';
                }
            }

            async function downloadSelectedVideos() {
                const selectedCheckboxes = document.querySelectorAll('.video-checkbox:checked');
                
                if (selectedCheckboxes.length === 0) {
                    alert('Selecione pelo menos um vídeo para baixar.');
                    return;
                }
                
                const selectedVideos = Array.from(selectedCheckboxes).map(cb => {
                    const index = parseInt(cb.dataset.index);
                    return playlistVideosData[index];
                });
                
                closePlaylistModal();
                
                // Inicia downloads sequenciais
                const btnDownload = document.getElementById('btnDownload');
                const progressContainer = document.getElementById('progressContainer');
                const statusMsg = document.getElementById('statusMsg');
                const resultContainer = document.getElementById('resultContainer');
                const progressBar = document.getElementById('progressBar');
                
                btnDownload.disabled = true;
                btnDownload.style.opacity = '0.5';
                progressContainer.style.display = 'block';
                resultContainer.innerHTML = '';
                
                let successCount = 0;
                let failCount = 0;
                const failedVideos = [];
                
                for (let i = 0; i < selectedVideos.length; i++) {
                    const video = selectedVideos[i];
                    statusMsg.innerText = `Baixando ${i + 1} de ${selectedVideos.length}: ${video.title}`;
                    progressBar.style.width = '0%';
                    progressBar.innerText = '0%';
                    progressBar.style.backgroundColor = '#4caf50';
                    
                    try {
                        const success = await downloadSingleVideo(video.url, currentPlaylistFormat, progressBar);
                        if (success) {
                            successCount++;
                        } else {
                            failCount++;
                            failedVideos.push(video.title);
                        }
                    } catch (err) {
                        failCount++;
                        failedVideos.push(video.title);
                        console.error(`Erro ao baixar ${video.title}:`, err);
                    }
                    
                    // Pausa breve entre downloads
                    if (i < selectedVideos.length - 1) {
                        await new Promise(resolve => setTimeout(resolve, 1000));
                    }
                }
                
                // Resumo final
                let summaryHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;">
                    <strong>Download de Playlist Concluído!</strong><br>
                    ✅ ${successCount} vídeo(s) baixado(s) com sucesso<br>`;
                
                if (failCount > 0) {
                    summaryHTML += `❌ ${failCount} vídeo(s) falharam<br><br>`;
                    summaryHTML += `<details><summary style="cursor: pointer;">Ver vídeos que falharam</summary><ul style="margin-top: 10px;">`;
                    failedVideos.forEach(title => {
                        summaryHTML += `<li style="font-size: 12px;">${title}</li>`;
                    });
                    summaryHTML += `</ul></details>`;
                }
                
                summaryHTML += `</div>`;
                resultContainer.innerHTML = summaryHTML;
                statusMsg.innerText = 'Playlist finalizada!';
                progressBar.style.width = '100%';
                progressBar.innerText = '100%';
                
                btnDownload.disabled = false;
                btnDownload.style.opacity = '1';
            }

            async function downloadSingleVideo(url, formato, progressBar) {
                return new Promise(async (resolve) => {
                    try {
                        const response = await fetch('/baixar-stream', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ tipo: 'yt', link: url, formato: formato })
                        });

                        const reader = response.body.getReader();
                        const decoder = new TextDecoder("utf-8");
                        let done = false;
                        let remainingChunk = "";
                        let hasError = false;

                        while (!done) {
                            const { value, done: readerDone } = await reader.read();
                            done = readerDone;
                            
                            if (value) {
                                const chunk = decoder.decode(value, {stream: true});
                                const allData = remainingChunk + chunk;
                                const lines = allData.split('\n');
                                remainingChunk = lines.pop();
                                
                                for (let line of lines) {
                                    if (line.startsWith('data: ')) {
                                        const data = line.substring(6).trim();
                                        if (data.startsWith('PROGRESS:')) {
                                            const percent = parseFloat(data.substring(9)).toFixed(1);
                                            progressBar.style.width = percent + '%';
                                            progressBar.innerText = percent + '%';
                                        } else if (data.startsWith('ERROR:')) {
                                            hasError = true;
                                        } else if (data.startsWith('DONE:')) {
                                            resolve(true);
                                            return;
                                        }
                                    }
                                }
                            }
                        }
                        
                        resolve(!hasError);
                    } catch (err) {
                        console.error('Erro no download:', err);
                        resolve(false);
                    }
                });
            }

            document.getElementById('downloadForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                
                const tipo = document.getElementById('itipolink').value;
                const link = document.getElementById('ilink').value;
                const formato = document.getElementById('iformato') ? document.getElementById('iformato').value : "video";
                const btnDownload = document.getElementById('btnDownload');
                const progressContainer = document.getElementById('progressContainer');
                const progressBar = document.getElementById('progressBar');
                const statusMsg = document.getElementById('statusMsg');
                const resultContainer = document.getElementById('resultContainer');

                // Validação de playlist
                if (tipo === 'playlist') {
                    const isPlaylist = link.includes('list=');
                    if (!isPlaylist) {
                        alert("Por favor, insira uma URL de playlist válida do YouTube (deve conter 'list=' na URL).");
                        return;
                    }
                    await loadPlaylistInfo(link, formato);
                    return;
                }

                // Basic validation
                const isYoutube = link.includes('youtube.com') || link.includes('youtu.be');
                if (tipo === 'img' && isYoutube) {
                    alert("Você selecionou 'Imagem', mas inseriu um link do YouTube. Por favor, modifique o tipo ou o link.");
                    return;
                }
                if (tipo === 'yt' && !isYoutube) {
                    alert("Você selecionou 'Vídeo Youtube', mas o link não parece ser do YouTube.");
                    return;
                }

                btnDownload.disabled = true;
                btnDownload.style.opacity = '0.5';
                progressContainer.style.display = 'block';
                progressBar.style.width = '0%';
                progressBar.innerText = '0%';
                progressBar.style.backgroundColor = '#4caf50';
                statusMsg.innerText = 'Buscando informações...';
                resultContainer.innerHTML = '';

                try {
                    const response = await fetch('/baixar-stream', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ tipo, link, formato })
                    });

                    const reader = response.body.getReader();
                    const decoder = new TextDecoder("utf-8");
                    let done = false;
                    let remainingChunk = "";

                    while (!done) {
                        const { value, done: readerDone } = await reader.read();
                        done = readerDone;
                        if (value) {
                            const chunk = decoder.decode(value, {stream: true});
                            const allData = remainingChunk + chunk;
                            const lines = allData.split('\n');
                            
                            remainingChunk = lines.pop();
                            
                            for (let line of lines) {
                                if (line.startsWith('data: ')) {
                                    const data = line.substring(6).trim();
                                    if (data.startsWith('TITLE:')) {
                                        const title = data.substring(6);
                                        statusMsg.innerText = tipo === 'yt' 
                                            ? `Baixando o vídeo "${title}"`
                                            : `Baixando a foto "${title}"`;
                                    } else if (data.startsWith('STATUS:')) {
                                        const status = data.substring(7);
                                        if(!statusMsg.innerText.includes('Baixando o vídeo') && !statusMsg.innerText.includes('Baixando a foto')) {
                                            statusMsg.innerText = status;
                                        }
                                    } else if (data.startsWith('PROGRESS:')) {
                                        const percent = parseFloat(data.substring(9)).toFixed(1);
                                        progressBar.style.width = percent + '%';
                                        progressBar.innerText = percent + '%';
                                    } else if (data.startsWith('DONE:')) {
                                        const path = data.substring(5);
                                        resultContainer.innerHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb;"><strong>Concluído!</strong><br>Salvo em:<br><code style="background: transparent; color: inherit; padding: 0;">${path}</code></div>`;
                                        progressBar.style.width = '100%';
                                        progressBar.innerText = '100%';
                                        statusMsg.innerText = 'Download finalizado!';
                                    } else if (data.startsWith('ERROR_TYPE:')) {
                                        // Apenas registra o tipo de erro, a mensagem vem em seguida
                                    } else if (data.startsWith('ERROR:')) {
                                        const err = data.substring(6);
                                        resultContainer.innerHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"><strong>Erro:</strong> ${err}</div>`;
                                        statusMsg.innerText = 'Ocorreu um erro.';
                                        progressBar.style.backgroundColor = '#f44336';
                                    }
                                }
                            }
                        }
                    }
                } catch (err) {
                    resultContainer.innerHTML = `<div style="padding: 15px; margin-top: 10px; border-radius: 4px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb;"><strong>Erro na requisição:</strong> ${err.message}</div>`;
                    statusMsg.innerText = 'Ocorreu um erro de conexão.';
                    progressBar.style.backgroundColor = '#f44336';
                } finally {
                    btnDownload.disabled = false;
                    btnDownload.style.opacity = '1';
                }
            });
            </script>
        </div>
</div>
